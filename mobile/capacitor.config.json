{
  "appId": "app.thehourbrief",
  "appName": "The Hour Brief",
  "webDir": "www",
  "backgroundColor": "#0c0d15",
  "server": {
    "url": "https://the-hour-brief.vercel.app",
    "cleartext": false,
    "allowNavigation": [
      "the-hour-brief.vercel.app",
      "*.the-hour-brief.vercel.app"
    ],
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0c0d15"
  },
  "android": {
    "backgroundColor": "#0c0d15"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0c0d15",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#17191c"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_thb",
      "iconColor": "#7c5cf0"
    }
  }
}