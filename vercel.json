{
  "functions": {
    "api/og.mjs": {
      "includeFiles": "{fonts/**,brand/**,node_modules/harfbuzzjs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/e/:date",
      "destination": "/api/share?t=e&date=:date"
    },
    {
      "source": "/s/:date/:id",
      "destination": "/api/share?t=s&date=:date&id=:id"
    },
    {
      "source": "/q/:date/:score",
      "destination": "/api/share?t=q&date=:date&score=:score"
    },
    {
      "source": "/l/:code",
      "destination": "/api/share?t=l&code=:code"
    }
  ],
  "crons": [
    {
      "path": "/api/post-digest",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/post-digest",
      "schedule": "30 5 * * *"
    }
  ]
}
