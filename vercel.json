{
  "functions": {
    "api/og.mjs": {
      "includeFiles": "{fonts/**,brand/**,node_modules/harfbuzzjs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/e/:date",
      "destination": "/api/share?t=e&date=:date"
    },
    {
      "source": "/s/:date/:id",
      "destination": "/api/share?t=s&date=:date&id=:id"
    },
    {
      "source": "/q/:date/:score",
      "destination": "/api/share?t=q&date=:date&score=:score"
    },
    {
      "source": "/l/:code",
      "destination": "/api/share?t=l&code=:code"
    },
    {
      "source": "/api/subscribe",
      "destination": "/api/newsletter?action=subscribe"
    },
    {
      "source": "/api/create-draft",
      "destination": "/api/newsletter?action=create-draft"
    },
    {
      "source": "/api/comments",
      "destination": "/api/interactions?action=comments"
    },
    {
      "source": "/api/vote",
      "destination": "/api/interactions?action=vote"
    },
    {
      "source": "/podcast.xml",
      "destination": "https://pub-1dafea4a948540db8413a044895e083c.r2.dev/podcast.xml"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/voices",
      "destination": "/leaders.html"
    },
    {
      "source": "/api/register-push",
      "destination": "/api/track"
    },
    {
      "source": "/linkedin/callback",
      "destination": "/api/post-digest?job=linkedin-callback"
    }
  ],
  "headers": [
    {
      "source": "/:dir(tools|mobile|social|leaders-pending|\\.github)/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/:file(DEPLOY\\.md|share-kit\\.html|growth\\.html|requirements\\.txt)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/:share(e|s|q|l)/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "crons": [
    {
      "path": "/api/post-digest",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/post-digest",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/leaders",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/leaders",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/leaders",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/post-digest",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/post-digest",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/post-digest",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/post-digest",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/post-digest",
      "schedule": "30 13 * * *"
    }
  ]
}
